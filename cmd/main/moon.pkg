supported_targets = "+native+wasm"

import {
  "mldong/moon-core" @core,
  "mldong/moon-core-web" @web,
  "mldong/moon-plugin-host" @host,
  "mldong/moon-token/app" @app,
  "mldong/moon-token/guard" @guard,
  "mldong/moon-token/style" @style,
  "mldong/moon-token-store/memory" @mem,
  "mldong/moon-token-moonback/guard" @mbguard,
  "mldong/moon-sys" @sys,
  "mldong/moon-app" @appmod,
  "mldong/moon-dev" @dev,
  "moonbitlang/core/env" @env,
  "moonbitlang/moonback" @mb,
  "moonbitlang/async",
}

pkgtype(kind: "executable")
