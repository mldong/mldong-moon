supported_targets = "+native+wasm"

import {
  "mldong/moon-core" @core,
  "mldong/moon-core-web" @web,
  "mldong/moon-plugin-host" @host,
  "mldong/moon-plugin-api" @api,
  "mldong/moon-plugin-jeeflow" @jeeflow,
  "mldong/moon-token/app" @app,
  "mldong/moon-token/guard" @guard,
  "mldong/moon-token/style" @style,
  "mldong/moon-token-store-redis/redis" @redis_store,
  "mldong/moon-token-store/port" @port,
  "mldong/moon-token-moonback/guard" @mbguard,
  "mldong/moon-sys" @sys,
  "mldong/moon-sys/api" @sysapi,
  "mldong/moon-app" @appmod,
  "mldong/moon-dev" @dev,
  "moonbitlang/core/env" @env,
  "moonbitlang/core/string" @string,
  "moonbitlang/moonback" @mb,
  "moonbitlang/async",
}

// `async fn main` 需要 import 本包；moonc 0.10.22 的 unused_package 不计这一用法，包级压掉。
warnings = "-unused_package"

pkgtype(kind: "executable")
