// `async fn main` 需要 import 本包；moonc 0.10.22 的 unused_package 不计这一用法，包级压掉。
warnings = "-unused_package"

pkgtype(kind: "executable")
supported_targets = "+native+wasm"

import {
  "mldong/moon-core" @core,
  "mldong/moon-dev/metadata" @meta,
  "mldong/moon-dev/metadata-mysql" @metamysql,
  "moonbitlang/async",
  "moonbitlang/async/fs" @fs,
  "moonbitlang/core/env" @env,
  "moonbitlang/core/string" @string,
}
