// sys_message 表编解码器 —— BaseDao 模板的每实体配置〔cmd/gen 生成，可手改〕

///|
let message_table : TableCodec[@entity.Message] = TableCodec::{
  name: "sys_message",
  cols: [
    "id",
    "title",
    "content",
    "msg_type",
    "biz_type",
    "biz_id",
    "receiver_user_id",
    "sender_user_id",
    "sender_name",
    "url",
    "variable",
    "is_read",
    "create_user",
    "create_time",
    "update_user",
    "update_time",
    "is_deleted",
  ],
  insert_cols: [
    { name: "id", get: fn(d) { L(d.id) } },
    { name: "title", get: fn(d) { S(d.title) } },
    { name: "content", get: fn(d) { opt_s(d.content) } },
    { name: "msg_type", get: fn(d) { I(d.msg_type) } },
    { name: "biz_type", get: fn(d) { S(d.biz_type) } },
    { name: "biz_id", get: fn(d) { opt_l(d.biz_id) } },
    { name: "receiver_user_id", get: fn(d) { L(d.receiver_user_id) } },
    { name: "sender_user_id", get: fn(d) { L(d.sender_user_id) } },
    { name: "sender_name", get: fn(d) { opt_s(d.sender_name) } },
    { name: "url", get: fn(d) { opt_s(d.url) } },
    { name: "variable", get: fn(d) { opt_s(d.variable) } },
    { name: "is_read", get: fn(d) { opt_i(d.is_read) } },
    { name: "create_time", get: fn(d) { S(match d.create_time { Some(s) => s; None => @core.now_str() }) } },
    { name: "update_time", get: fn(d) { S(match d.update_time { Some(s) => s; None => @core.now_str() }) } },
    { name: "create_user", get: fn(d) { opt_l(d.create_user) } },
    { name: "update_user", get: fn(d) { opt_l(d.update_user) } },
  ],
  update_cols: [
    { name: "title", get: fn(d) { S(d.title) } },
    { name: "content", get: fn(d) { opt_s(d.content) } },
    { name: "msg_type", get: fn(d) { I(d.msg_type) } },
    { name: "biz_type", get: fn(d) { S(d.biz_type) } },
    { name: "biz_id", get: fn(d) { opt_l(d.biz_id) } },
    { name: "receiver_user_id", get: fn(d) { L(d.receiver_user_id) } },
    { name: "sender_user_id", get: fn(d) { L(d.sender_user_id) } },
    { name: "sender_name", get: fn(d) { opt_s(d.sender_name) } },
    { name: "url", get: fn(d) { opt_s(d.url) } },
    { name: "variable", get: fn(d) { opt_s(d.variable) } },
    { name: "is_read", get: fn(d) { opt_i(d.is_read) } },
    { name: "update_time", get: fn(_d) { S(@core.now_str()) } },
    { name: "update_user", get: fn(d) { opt_l(d.update_user) } },
  ],
  from_row: row_message,
  id_of: fn(d) { L(d.id) },
  del_col: Some("is_deleted"),
  order_col: "create_time",
}

///|
/// 行映射按列名取 —— 手写行映射（无反射）
fn row_message(r : @moondb.Row) -> @entity.Message {
  {
    id: row_i64(r, "id"),
    title: row_text(r, "title", ""),
    content: row_opt_text(r, "content"),
    msg_type: row_int_d(r, "msg_type", 0),
    biz_type: row_text(r, "biz_type", ""),
    biz_id: row_opt_i64(r, "biz_id"),
    receiver_user_id: row_i64(r, "receiver_user_id"),
    sender_user_id: row_i64(r, "sender_user_id"),
    sender_name: row_opt_text(r, "sender_name"),
    url: row_opt_text(r, "url"),
    variable: row_opt_text(r, "variable"),
    is_read: row_opt_int(r, "is_read"),
    create_user: row_opt_i64(r, "create_user"),
    create_time: row_opt_text(r, "create_time"),
    update_user: row_opt_i64(r, "update_user"),
    update_time: row_opt_text(r, "update_time"),
    is_deleted: row_opt_int(r, "is_deleted"),
  }
}
