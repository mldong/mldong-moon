/// 行映射按列名取 —— MyBatis resultMap 的手写对应物
fn row_oplog(r : @moondb.Row) -> @entity.OpLog {
  {
    id: row_i64(r, "id"),
    name: row_opt_text(r, "name"),
    op_type: row_opt_int(r, "op_type"),
    success: row_opt_text(r, "success"),
    message: row_opt_text(r, "message"),
