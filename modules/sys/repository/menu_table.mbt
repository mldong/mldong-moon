///|
let menu_table : TableCodec[@entity.Menu] = TableCodec::{
  name: "sys_menu",
  cols: [
    "id",
    "app_code",
    "parent_id",
    "name",
    "code",
    "pids",
    "type",
    "sort",
    "path",
    "component",
    "icon",
    "is_show",
    "is_link",
    "url",
    "enabled",
    "open_type",
    "is_cache",
    "is_sync",
    "variable",
    "create_time",
    "create_user",
    "update_time",
    "update_user",
    "is_deleted",
  ],
  insert_cols: [
    { name: "id", get: fn(d) { L(d.id) } },
    { name: "app_code", get: fn(d) { opt_s(d.app_code) } },
    { name: "parent_id", get: fn(d) { opt_l(d.parent_id) } },
    { name: "name", get: fn(d) { S(d.name) } },
    { name: "code", get: fn(d) { S(d.code) } },
    { name: "type", get: fn(d) { opt_i(d.menu_type) } },
    { name: "sort", get: fn(d) { opt_l(d.sort) } },
    { name: "path", get: fn(d) { opt_s(d.path) } },
    { name: "component", get: fn(d) { opt_s(d.component) } },
    { name: "icon", get: fn(d) { opt_s(d.icon) } },
    { name: "is_show", get: fn(d) { opt_i(d.is_show) } },
    { name: "is_link", get: fn(d) { opt_i(d.is_link) } },
    { name: "url", get: fn(d) { opt_s(d.url) } },
    { name: "enabled", get: fn(d) { opt_i(d.enabled) } },
    { name: "open_type", get: fn(d) { opt_i(d.open_type) } },
    { name: "is_cache", get: fn(d) { opt_i(d.is_cache) } },
    { name: "is_sync", get: fn(d) { opt_i(d.is_sync) } },
    { name: "variable", get: fn(d) { opt_s(d.variable) } },
    { name: "create_time", get: fn(d) { S(match d.create_time { Some(s) => s; None => @core.now_str() }) } },
    { name: "update_time", get: fn(d) { S(match d.update_time { Some(s) => s; None => @core.now_str() }) } },
    { name: "create_user", get: fn(d) { opt_l(d.create_user) } },
    { name: "update_user", get: fn(d) { opt_l(d.update_user) } },
  ],
  update_cols: [
    { name: "app_code", get: fn(d) { opt_s(d.app_code) } },
    { name: "parent_id", get: fn(d) { opt_l(d.parent_id) } },
    { name: "name", get: fn(d) { S(d.name) } },
    { name: "code", get: fn(d) { S(d.code) } },
    { name: "type", get: fn(d) { opt_i(d.menu_type) } },
    { name: "sort", get: fn(d) { opt_l(d.sort) } },
    { name: "path", get: fn(d) { opt_s(d.path) } },
    { name: "component", get: fn(d) { opt_s(d.component) } },
    { name: "icon", get: fn(d) { opt_s(d.icon) } },
    { name: "is_show", get: fn(d) { opt_i(d.is_show) } },
    { name: "is_link", get: fn(d) { opt_i(d.is_link) } },
    { name: "url", get: fn(d) { opt_s(d.url) } },
    { name: "enabled", get: fn(d) { opt_i(d.enabled) } },
    { name: "open_type", get: fn(d) { opt_i(d.open_type) } },
    { name: "is_cache", get: fn(d) { opt_i(d.is_cache) } },
    { name: "is_sync", get: fn(d) { opt_i(d.is_sync) } },
    { name: "variable", get: fn(d) { opt_s(d.variable) } },
    { name: "update_time", get: fn(_d) { S(@core.now_str()) } },
    { name: "update_user", get: fn(d) { opt_l(d.update_user) } },
  ],
  from_row: row_menu,
  id_of: fn(d) { L(d.id) },
  del_col: Some("is_deleted"),
  order_col: "create_time",
}

///|
/// 行映射按列名取 —— MyBatis resultMap 的手写对应物
fn row_menu(r : @moondb.Row) -> @entity.Menu {
  {
    id: row_i64(r, "id"),
    app_code: row_opt_text(r, "app_code"),
    parent_id: row_opt_i64(r, "parent_id"),
    name: row_text(r, "name", ""),
    code: row_text(r, "code", ""),
    pids: row_opt_text(r, "pids"),
    menu_type: row_opt_int(r, "type"),
    sort: row_opt_i64(r, "sort"),
    path: row_opt_text(r, "path"),
    component: row_opt_text(r, "component"),
    icon: row_opt_text(r, "icon"),
    is_show: row_opt_int(r, "is_show"),
    is_link: row_opt_int(r, "is_link"),
    url: row_opt_text(r, "url"),
    enabled: row_opt_int(r, "enabled"),
    open_type: row_opt_int(r, "open_type"),
    is_cache: row_opt_int(r, "is_cache"),
    is_sync: row_opt_int(r, "is_sync"),
    variable: row_opt_text(r, "variable"),
    create_time: row_opt_text(r, "create_time"),
    create_user: row_opt_i64(r, "create_user"),
    update_time: row_opt_text(r, "update_time"),
    update_user: row_opt_i64(r, "update_user"),
    is_deleted: row_opt_int(r, "is_deleted"),
  }
}
