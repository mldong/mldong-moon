///|
/// 行映射按列名取 —— MyBatis resultMap 的手写对应物
fn row_fileinfo(r : @moondb.Row) -> @entity.FileInfo {
  {
    id: row_i64(r, "id"),
    url: row_text(r, "url", ""),
    size: row_opt_i64(r, "size"),
    size_info: row_opt_text(r, "size_info"),
    filename: row_opt_text(r, "filename"),
    original_filename: row_opt_text(r, "original_filename"),
    base_path: row_opt_text(r, "base_path"),
    path: row_opt_text(r, "path"),
    ext: row_opt_text(r, "ext"),
    content_type: row_opt_text(r, "content_type"),
    platform: row_opt_text(r, "platform"),
    th_url: row_opt_text(r, "th_url"),
    th_filename: row_opt_text(r, "th_filename"),
    th_size: row_opt_i64(r, "th_size"),
    th_size_info: row_opt_text(r, "th_size_info"),
    th_content_type: row_opt_text(r, "th_content_type"),
    object_id: row_opt_text(r, "object_id"),
    object_type: row_opt_text(r, "object_type"),
    attr: row_opt_text(r, "attr"),
    create_time: row_opt_text(r, "create_time"),
    create_user: row_opt_i64(r, "create_user"),
    update_time: row_opt_text(r, "update_time"),
    update_user: row_opt_i64(r, "update_user"),
  }
}
