    { name: "platform", get: fn(d) { opt_s(d.platform) } },
    { name: "th_url", get: fn(d) { opt_s(d.th_url) } },
    { name: "th_filename", get: fn(d) { opt_s(d.th_filename) } },
    { name: "th_size", get: fn(d) { opt_l(d.th_size) } },
    { name: "th_size_info", get: fn(d) { opt_s(d.th_size_info) } },
    { name: "th_content_type", get: fn(d) { opt_s(d.th_content_type) } },
    { name: "object_id", get: fn(d) { opt_s(d.object_id) } },
    { name: "object_type", get: fn(d) { opt_s(d.object_type) } },
    { name: "attr", get: fn(d) { opt_s(d.attr) } },
    { name: "create_time", get: fn(d) { S(match d.create_time { Some(s) => s; None => @core.now_str() }) } },
    { name: "update_time", get: fn(d) { S(match d.update_time { Some(s) => s; None => @core.now_str() }) } },
    { name: "create_user", get: fn(d) { opt_l(d.create_user) } },
    { name: "update_user", get: fn(d) { opt_l(d.update_user) } },
  ],
  update_cols: [
    { name: "url", get: fn(d) { S(d.url) } },
    { name: "size", get: fn(d) { opt_l(d.size) } },
    { name: "size_info", get: fn(d) { opt_s(d.size_info) } },
    { name: "filename", get: fn(d) { opt_s(d.filename) } },
    { name: "original_filename", get: fn(d) { opt_s(d.original_filename) } },
    { name: "base_path", get: fn(d) { opt_s(d.base_path) } },
