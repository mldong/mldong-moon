    "object_id",
    "object_type",
    "attr",
    "create_time",
    "create_user",
    "update_time",
    "update_user",
  ],
  insert_cols: [
    { name: "id", get: fn(d) { L(d.id) } },
    { name: "url", get: fn(d) { S(d.url) } },
    { name: "size", get: fn(d) { opt_l(d.size) } },
    { name: "size_info", get: fn(d) { opt_s(d.size_info) } },
    { name: "filename", get: fn(d) { opt_s(d.filename) } },
    { name: "original_filename", get: fn(d) { opt_s(d.original_filename) } },
