// sys_file_info 表编解码器 —— BaseDao 模板的每实体配置〔cmd/gen 生成，可手改〕

///|
let fileinfo_table : TableCodec[@entity.FileInfo] = TableCodec::{
  name: "sys_file_info",
  cols: [
    "id",
    "url",
    "size",
    "size_info",
    "filename",
    "original_filename",
    "base_path",
    "path",
