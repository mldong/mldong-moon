// dev_schema 表编解码器 —— BaseDao 模板的每实体配置〔cmd/gen 生成，可手改〕

///|
let schema_table : TableCodec[@entity.Schema] = TableCodec::{
  name: "dev_schema",
  cols: [
    "id",
    "schema_group_id",
    "table_name",
    "remark",
    "other_remark",
    "table_type",
    "form_type",
    "is_tree",
    "sort",
    "icon",
    "search_form_keys",
    "list_keys",
    "variable",
    "create_time",
    "create_user",
    "update_time",
    "update_user",
    "is_deleted",
  ],
  insert_cols: [
    { name: "id", get: fn(d) { L(d.id) } },
    { name: "schema_group_id", get: fn(d) { opt_l(d.schema_group_id) } },
    { name: "table_name", get: fn(d) { S(d.table_name) } },
    { name: "remark", get: fn(d) { S(d.remark) } },
    { name: "other_remark", get: fn(d) { opt_s(d.other_remark) } },
    { name: "table_type", get: fn(d) { opt_i(d.table_type) } },
    { name: "form_type", get: fn(d) { opt_i(d.form_type) } },
    { name: "is_tree", get: fn(d) { opt_i(d.is_tree) } },
    { name: "sort", get: fn(d) { opt_l(d.sort) } },
    { name: "icon", get: fn(d) { opt_s(d.icon) } },
    { name: "search_form_keys", get: fn(d) { opt_s(d.search_form_keys) } },
    { name: "list_keys", get: fn(d) { opt_s(d.list_keys) } },
    { name: "variable", get: fn(d) { opt_s(d.variable) } },
    { name: "create_time", get: fn(d) { S(match d.create_time { Some(s) => s; None => @core.now_str() }) } },
    { name: "update_time", get: fn(d) { S(match d.update_time { Some(s) => s; None => @core.now_str() }) } },
    { name: "create_user", get: fn(d) { opt_l(d.create_user) } },
    { name: "update_user", get: fn(d) { opt_l(d.update_user) } },
  ],
  update_cols: [
    { name: "schema_group_id", get: fn(d) { opt_l(d.schema_group_id) } },
    { name: "table_name", get: fn(d) { S(d.table_name) } },
    { name: "remark", get: fn(d) { S(d.remark) } },
    { name: "other_remark", get: fn(d) { opt_s(d.other_remark) } },
    { name: "table_type", get: fn(d) { opt_i(d.table_type) } },
    { name: "form_type", get: fn(d) { opt_i(d.form_type) } },
    { name: "is_tree", get: fn(d) { opt_i(d.is_tree) } },
    { name: "sort", get: fn(d) { opt_l(d.sort) } },
    { name: "icon", get: fn(d) { opt_s(d.icon) } },
    { name: "search_form_keys", get: fn(d) { opt_s(d.search_form_keys) } },
    { name: "list_keys", get: fn(d) { opt_s(d.list_keys) } },
    { name: "variable", get: fn(d) { opt_s(d.variable) } },
    { name: "update_time", get: fn(_d) { S(@core.now_str()) } },
    { name: "update_user", get: fn(d) { opt_l(d.update_user) } },
  ],
  from_row: row_schema,
  id_of: fn(d) { L(d.id) },
  del_col: Some("is_deleted"),
  order_col: "create_time",
}

///|
/// 行映射按列名取 —— MyBatis resultMap 的手写对应物
fn row_schema(r : @moondb.Row) -> @entity.Schema {
  {
    id: row_i64(r, "id"),
    schema_group_id: row_opt_i64(r, "schema_group_id"),
    table_name: row_text(r, "table_name", ""),
    remark: row_text(r, "remark", ""),
    other_remark: row_opt_text(r, "other_remark"),
    table_type: row_opt_int(r, "table_type"),
    form_type: row_opt_int(r, "form_type"),
    is_tree: row_opt_int(r, "is_tree"),
    sort: row_opt_i64(r, "sort"),
    icon: row_opt_text(r, "icon"),
    search_form_keys: row_opt_text(r, "search_form_keys"),
    list_keys: row_opt_text(r, "list_keys"),
    variable: row_opt_text(r, "variable"),
    create_time: row_opt_text(r, "create_time"),
    create_user: row_opt_i64(r, "create_user"),
    update_time: row_opt_text(r, "update_time"),
    update_user: row_opt_i64(r, "update_user"),
    is_deleted: row_opt_int(r, "is_deleted"),
  }
}
