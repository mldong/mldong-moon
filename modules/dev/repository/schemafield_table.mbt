// dev_schema_field 表编解码器 —— BaseDao 模板的每实体配置〔cmd/gen 生成，可手改〕

///|
let schemafield_table : TableCodec[@entity.SchemaField] = TableCodec::{
  name: "dev_schema_field",
  cols: [
    "id",
    "schema_id",
    "field_name",
    "remark",
    "field_size",
    "data_type",
    "is_primary",
    "nullable",
    "default_value",
    "component",
    "sort",
    "variable",
    "create_time",
    "create_user",
    "update_time",
    "update_user",
    "is_deleted",
  ],
  insert_cols: [
    { name: "id", get: fn(d) { L(d.id) } },
    { name: "schema_id", get: fn(d) { L(d.schema_id) } },
    { name: "field_name", get: fn(d) { S(d.field_name) } },
    { name: "remark", get: fn(d) { S(d.remark) } },
    { name: "field_size", get: fn(d) { opt_i(d.field_size) } },
    { name: "data_type", get: fn(d) { opt_s(d.data_type) } },
    { name: "is_primary", get: fn(d) { opt_i(d.is_primary) } },
    { name: "nullable", get: fn(d) { opt_i(d.nullable) } },
    { name: "default_value", get: fn(d) { opt_s(d.default_value) } },
    { name: "component", get: fn(d) { opt_s(d.component) } },
    { name: "sort", get: fn(d) { opt_l(d.sort) } },
    { name: "variable", get: fn(d) { opt_s(d.variable) } },
    { name: "create_time", get: fn(d) { S(match d.create_time { Some(s) => s; None => @core.now_str() }) } },
    { name: "update_time", get: fn(d) { S(match d.update_time { Some(s) => s; None => @core.now_str() }) } },
    { name: "create_user", get: fn(d) { opt_l(d.create_user) } },
    { name: "update_user", get: fn(d) { opt_l(d.update_user) } },
  ],
  update_cols: [
    { name: "schema_id", get: fn(d) { L(d.schema_id) } },
    { name: "field_name", get: fn(d) { S(d.field_name) } },
    { name: "remark", get: fn(d) { S(d.remark) } },
    { name: "field_size", get: fn(d) { opt_i(d.field_size) } },
    { name: "data_type", get: fn(d) { opt_s(d.data_type) } },
    { name: "is_primary", get: fn(d) { opt_i(d.is_primary) } },
    { name: "nullable", get: fn(d) { opt_i(d.nullable) } },
    { name: "default_value", get: fn(d) { opt_s(d.default_value) } },
    { name: "component", get: fn(d) { opt_s(d.component) } },
    { name: "sort", get: fn(d) { opt_l(d.sort) } },
    { name: "variable", get: fn(d) { opt_s(d.variable) } },
    { name: "update_time", get: fn(_d) { S(@core.now_str()) } },
    { name: "update_user", get: fn(d) { opt_l(d.update_user) } },
  ],
  from_row: row_schemafield,
  id_of: fn(d) { L(d.id) },
  del_col: Some("is_deleted"),
  order_col: "create_time",
}

///|
/// 行映射按列名取 —— MyBatis resultMap 的手写对应物
fn row_schemafield(r : @moondb.Row) -> @entity.SchemaField {
  {
    id: row_i64(r, "id"),
    schema_id: row_i64(r, "schema_id"),
    field_name: row_text(r, "field_name", ""),
    remark: row_text(r, "remark", ""),
    field_size: row_opt_int(r, "field_size"),
    data_type: row_opt_text(r, "data_type"),
    is_primary: row_opt_int(r, "is_primary"),
    nullable: row_opt_int(r, "nullable"),
    default_value: row_opt_text(r, "default_value"),
    component: row_opt_text(r, "component"),
    sort: row_opt_i64(r, "sort"),
    variable: row_opt_text(r, "variable"),
    create_time: row_opt_text(r, "create_time"),
    create_user: row_opt_i64(r, "create_user"),
    update_time: row_opt_text(r, "update_time"),
    update_user: row_opt_i64(r, "update_user"),
    is_deleted: row_opt_int(r, "is_deleted"),
  }
}
